const std = @import("std");
const linux = std.os.linux;

const network = @import("network.zig");
const logging = @import("logging.zig");

var rv: usize = 0;

pub fn main(_: std.process.Init) !void {
    std.log.info("Starting server...", .{});

    var server: network.Server = undefined;
    try server.init();
    defer server.deinit();

    try server.bind(6767);
    try server.listen();

    std.log.info("Server listening on port {d}", .{server.port});

    rv = linux.epoll_create();
    const epoll_fd: i32 = switch (linux.errno(rv)) {
        .SUCCESS => @intCast(rv),
        else => |errno| {
            std.log.err(
                "epoll_create() failed to create epoll fd {s}",
                .{@tagName(errno)},
            );
            return error.EpollCreateFailed;
        },
    };
    defer _ = linux.close(epoll_fd);

    var epoll_event: linux.epoll_event = .{
        .events = linux.EPOLL.IN,
        .data = .{ .fd = server.socket },
    };
    rv = linux.epoll_ctl(epoll_fd, linux.EPOLL.CTL_ADD, server.socket, &epoll_event);
    switch (linux.errno(rv)) {
        .SUCCESS => {},
        else => |errno| {
            std.log.err("epoll_ctl() failed {s}", .{@tagName(errno)});
            return error.EpollCtlFailed;
        },
    }

    var epoll_events: [64]linux.epoll_event = undefined;

    while (true) {
        // const client_fd: i32 = server.accept() catch |err| switch (err) {
        //     error.RetryAccept => continue,
        //     else => return err,
        // };
        // var client: network.Client = undefined;
        // client.init(client_fd);
        // defer client.deinit();

        const n_fd: usize = linux.epoll_wait(
            epoll_fd,
            &epoll_events,
            epoll_events.len,
            -1,
        );
        switch (linux.errno(n_fd)) {
            .SUCCESS => {},
            else => continue,
        }

        for (epoll_events[0..n_fd]) |ev| {
            const fd: i32 = ev.data.fd;

            if (fd == server.socket) {
                const client_fd: i32 = server.accept() catch |err| switch (err) {
                    error.RetryAccept => continue,
                    else => return err,
                };
                var client: network.Client = undefined;
                client.init(client_fd);

                epoll_event = .{
                    .events = linux.EPOLL.IN,
                    .data = .{ .fd = client.fd },
                };
                rv = linux.epoll_ctl(
                    epoll_fd,
                    linux.EPOLL.CTL_ADD,
                    client.fd,
                    &epoll_event,
                );
                switch (linux.errno(rv)) {
                    .SUCCESS => {},
                    else => |errno| {
                        std.log.err(
                            "epoll_ctl() failed to register client {s}",
                            .{@tagName(errno)},
                        );
                        client.deinit();
                    },
                }
            } else {
                // TODO: Read Data
            }
        }
    }
}
